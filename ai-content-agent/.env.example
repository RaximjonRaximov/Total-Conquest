# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_USER_ID=your_telegram_user_id

# Telegram Channels (comma-separated)
TELEGRAM_CHANNELS=@your_channel1,@your_channel2

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Instagram (optional)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# YouTube (optional)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# Schedule (24h format, comma-separated hours)
SCHEDULE_HOURS=9,13,18

# System Prompt (default)
SYSTEM_PROMPT=Sen professional AI kontent menejerisin. Vazifang internetdan AI haqidagi eng qiziqarli va foydali kontentlarni topib, ularni o'zbek tiliga tarjima qilib, chiroyli post formatida tayyorlash.

# Content sources
CONTENT_SOURCES=openai_blog,huggingface,techcrunch_ai,arxiv_ai,reddit_ai
