# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=total_conquest
DB_USER=tc_user
DB_PASSWORD=strongpassword123

# Redis
REDIS_URL=redis://localhost:6379

# JWT (generate: openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_here_min_64_chars
JWT_REFRESH_SECRET=another_super_secret_refresh_key_here
JWT_ACCESS_TTL=900        # 15 min (seconds)
JWT_REFRESH_TTL=604800    # 7 days (seconds)

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Telegram Bot (for guest save feature)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=TotalConquestBot

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=100        # requests per minute per IP
